{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "codegreen-uva.ddns.net",
  "AppSettings": {
    "BaseUrl": "https://codegreen-uva.ddns.net",
    "EnforceAuth": true,
    "TrustForwardedHeaders": true,
    "AllowedOrigins": ["https://codegreen-uva.ddns.net"],
    "RateLimit": {
      "Enabled": true,
      "Requests": 60,
      "WindowSeconds": 60
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      },
      "Https": {
        "Url": "https://0.0.0.0:5001",
        "Certificate": {
          "Path": "",
          "Password": ""
        }
      }
    }
  }
}
