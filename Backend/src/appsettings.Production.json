{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "yourdomain.com",
  "AppSettings": {
    "BaseUrl": "https://yourdomain.com",
    "EnforceAuth": true,
    "AllowedOrigins": ["https://yourdomain.com"],
    "RateLimit": {
      "Enabled": true,
      "Requests": 60,
      "WindowSeconds": 60
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      },
      "Https": {
        "Url": "https://0.0.0.0:5001",
        "Certificate": {
          "Path": "/etc/pse-green/certs/certificate.pfx",
          "Password": "REPLACE_WITH_YOUR_CERTIFICATE_PASSWORD"
        }
      }
    }
  }
}
